# Copy to .env and fill in. `.env` is gitignored; this file is the documented shape.
# Variables here are exported by `make`, so Terraform picks up the TF_VAR_* ones
# without any recipe knowing about them.
#
# Plain KEY=value, no quotes and no spaces around the equals sign.

# Address subscribed to both alarm topics, Paris and us-east-1. Empty means the
# alarms change state and reach nobody.
TF_VAR_alarm_email=

# Optional, per deploy only. Enables the cookies hook when a cookies file exists
# under config/ in that environment's bucket. Pass it on the command line rather
# than storing it here, since one value would otherwise apply to both environments:
#   export TF_VAR_ytdlp_cookies_s3_uri="s3://ytdl-<account-id>-dev-media/config/cookies.txt"
