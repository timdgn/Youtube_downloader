# syntax=docker/dockerfile:1
#
# The Docker deployment (Raspberry Pi): one image, two roles. The default
# command is the HTTP front end; the worker service overrides it with
# `python -m ytdl.server.worker_loop`.
#
# Build for the Pi's architecture on an arm64 host:
#   docker buildx build --platform linux/arm64 -f Dockerfile.pi -t ytdl-pi:<tag> app
#
# Every tool is pinned by version and, for downloaded binaries, by SHA-256.

FROM python:3.13.15-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG FFMPEG_RELEASE=autobuild-2026-11-15-21-54
ARG FFMPEG_ASSET=ffmpeg-N-128946-g33a5956d8b-linuxarm64-gpl.tar.xz
ARG FFMPEG_SHA256=3d6fd3906a050cfffea18d551ad28396835326f67ff9aeccf734ce253659c591
ARG DENO_VERSION=v2.9.8
ARG DENO_SHA256=d49596c20b9788cf8f5d8ddf644103d4bde56ed239753f0bdb92ba9361d51905

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl xz-utils unzip \
 && rm -rf /var/lib/apt/lists/*

# Media tooling, fetched once and verified before use.
WORKDIR /opt/build
RUN curl -fsSL -o ffmpeg.tar.xz \
      "https://github.com/yt-dlp/FFmpeg-Builds/releases/download/${FFMPEG_RELEASE}/${FFMPEG_ASSET}" \
 && echo "${FFMPEG_SHA256}  ffmpeg.tar.xz" | sha256sum -c - \
 && mkdir -p /opt/ffmpeg \
 && tar -xJf ffmpeg.tar.xz -C /opt/ffmpeg --strip-components=1 \
 && install -m 0755 /opt/ffmpeg/bin/ffmpeg /opt/ffmpeg/bin/ffprobe /usr/local/bin/ \
 && rm -rf ffmpeg.tar.xz /opt/ffmpeg

RUN curl -fsSL -o deno.zip \
      "https://github.com/denoland/deno/releases/download/${DENO_VERSION}/deno-aarch64-unknown-linux-gnu.zip" \
 && echo "${DENO_SHA256}  deno.zip" | sha256sum -c - \
 && unzip -q deno.zip -d /usr/local/bin \
 && rm -f deno.zip \
 && chmod +x /usr/local/bin/deno

COPY requirements.txt /tmp/requirements.txt
RUN python -m pip install -r /tmp/requirements.txt

# The extraction version is read from one file, so the image and the plan
# cannot drift apart.
COPY ytdlp-version.txt /tmp/ytdlp-version.txt
RUN python -m pip install "yt-dlp[default]==$(cat /tmp/ytdlp-version.txt)" \
 && python -m pip show yt-dlp-ejs | grep -E '^(Name|Version):' \
 && yt-dlp --version \
 && ffmpeg -version | head -n 1 \
 && deno --version | head -n 1

COPY src/ /app/src/
WORKDIR /app

EXPOSE 8090
CMD ["python", "-m", "ytdl.server.web"]
